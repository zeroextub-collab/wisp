# Build artifacts (root-anchored: never match source dirs of the same
# name nested inside the package)
/build-ninja/
/build/
/dist/
*.egg-info/

# Compiled C extension (built per-machine by pip install -e .)
wisp/_wisp_core*.pyd
wisp/_wisp_core*.so
wisp/_wisp_core*.dll

# Python cache
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Logs
*.log

# Model weights — ROOT-ANCHORED ON PURPOSE.
# An unanchored `models/` also matches wisp/models/, which is SOURCE
# (the model adapters) and silently broke the first published commit.
/models/
_hf_*/
*.bin
*.safetensors
*.gguf

# Download state
download_state.json
download_state_*.json

# WISP cache
.wisp/
wisp_sim_cache/

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/
